# ==========================================
# Lost and Found Tracker - Environment Variables
# ==========================================
# This project contains separate environment files for the server and client.
# Copy the corresponding .env.example files into .env in each directory.

# ------------------------------------------
# 1. Server Configuration (server/.env)
# ------------------------------------------
# PORT=4000
# DB=mongodb://127.0.0.1:27017/lost-found-mern
# SECRET_KEY=your_super_secret_jwt_key_here
# CLIENT_URL=http://localhost:3000

# ------------------------------------------
# 2. Client Configuration (client/.env)
# ------------------------------------------
# REACT_APP_API_URL=http://localhost:4000
# REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
